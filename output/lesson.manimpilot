  "lesson": {
    "id": "bea2c7ec910c469fa9fb6e5137eb9cc7",
    "title": "\u0DAF\u0DCA\u0DC0\u0DD2\u0DB8\u0DBA \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF \u0DAF\u0DC1\u0DB8 \u0DB6\u0DC0\u0DA7 \u0DC4\u0DD0\u0DBB\u0DC0\u0DD3\u0DB8 (10110110)",
    "topic": "BinaryToDecimal",
    "language": "si-LK",
    "description": "10110110 \u0DAF\u0DCA\u0DC0\u0DD2\u0DB8\u0DBA \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF\u0DC0 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DD3\u0DBA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DB7\u0DCF\u0DC0\u0DD2\u0DAD\u0DBA\u0DD9\u0DB1\u0DCA 182 \u0DAF\u0DC1\u0DB8 \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF\u0DC0 \u0DB6\u0DC0\u0DA7 \u0DB4\u0DAD\u0DCA \u0D9A\u0DBB\u0DB1 \u0D86\u0D9A\u0DCF\u0DBB\u0DBA.",
    "steps": [
      {
        "id": "step_01",
        "order_index": 1,
        "title": "\u0DAF\u0DCA\u0DC0\u0DD2\u0DB8\u0DBA \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF\u0DC0 \u0D89\u0DAF\u0DD2\u0DBB\u0DD2\u0DB4\u0DAD\u0DCA \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8",
        "type": "show_binary",
        "duration": 7.06,
        "visual": {
          "binary": "10110110",
          "highlight_color": "#FFD700",
          "custom_props": {}
        },
        "narration": {
          "text": "\u0D85\u0DB4\u0DD2\u0DA7 \u0DAF\u0DD3\u0DBD\u0DCF \u0DAD\u0DD2\u0DBA\u0DD9\u0DB1\u0DCA\u0DB1\u0DDA 10110110 \u0D9A\u0DD2\u0DBA\u0DB1 binary \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF\u0DC0\u0DBA\u0DD2. \u0D85\u0DB4\u0DD2 \u0DAF\u0DD0\u0DB1\u0DCA \u0DB8\u0DD9\u0DBA \u0DAF\u0DC1\u0DB8 \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF\u0DC0\u0D9A\u0DCA \u0DB6\u0DC0\u0DA7 \u0DC4\u0DBB\u0DC0\u0DB8\u0DD4.",
          "spoken_text": "\u0D85\u0DB4\u0DD2\u0DA7 \u0DAF\u0DD3\u0DBD\u0DCF \u0DAD\u0DD2\u0DBA\u0DD9\u0DB1\u0DCA\u0DB1\u0DDA \u0D91\u0D9A, \u0DB6\u0DD2\u0D82\u0DAF\u0DD4\u0DC0, \u0D91\u0D9A, \u0D91\u0D9A, \u0DB6\u0DD2\u0D82\u0DAF\u0DD4\u0DC0, \u0D91\u0D9A, \u0D91\u0D9A, \u0DB6\u0DD2\u0D82\u0DAF\u0DD4\u0DC0 \u0D9A\u0DD2\u0DBA\u0DB1 \u0DAF\u0DCA\u0DC0\u0DD2\u0DB8\u0DBA \u0DC3\u0D82\u0D9B\u0DCA\u200D\u0DBA\u0DCF\u0DC0\u0DBA\u0DD2.",
          "anchor": "step_01_binary_shown",
          "timing": "AfterEvent",
          "offset_seconds": 0.3,
          "audio_duration": 6.46
        }
      },
      {
        "id": "step_02",
        "order_index": 2,
        "title": "\u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DD3\u0DBA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DAF\u0DD0\u0D9A\u0DCA\u0DC0\u0DD3\u0DB8",
        "type": "show_place_values",
        "duration": 5.68,
        "visual": {
          "binary": "10110110",
          "place_values": [
            128,
            64,
            32,
            16,
            8,
            4,
            2,
            1
          ],
          "highlight_color": "#FFD700",
          "custom_props": {}
        },
        "narration": {
          "text": "\u0DAF\u0D9A\u0DD4\u0DAB\u0DDA \u0DC3\u0DD2\u0DA7 \u0DC0\u0DB8\u0DA7 \u0DAF\u0DD9\u0D9A\u0DD9\u0DC4\u0DD2 \u0DB6\u0DBD\u0DBA\u0DB1\u0DCA \u0D85\u0DB1\u0DD4\u0DC0 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DD3\u0DBA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DB4\u0DD2\u0DC5\u0DD2\u0DC0\u0DD9\u0DC5\u0DD2\u0DB1\u0DCA \u0DBD\u0DD2\u0DBA\u0DCF \u0D9C\u0DB1\u0DD2\u0DB8\u0DD4.",
          "spoken_text": "\u0DAF\u0D9A\u0DD4\u0DAB\u0DDA \u0DC3\u0DD2\u0DA7 \u0DC0\u0DB8\u0DA7 \u0DAF\u0DD9\u0D9A\u0DDA \u0DB6\u0DBD\u0DBA\u0DB1\u0DCA \u0D85\u0DB1\u0DD4\u0DC0 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DD3\u0DBA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DB4\u0DD2\u0DC5\u0DD2\u0DC0\u0DD9\u0DC5\u0DD2\u0DB1\u0DCA \u0DC3\u0DA7\u0DC4\u0DB1\u0DCA \u0D9A\u0DBB\u0DB8\u0DD4.",
          "anchor": "step_02_pv_shown",
          "timing": "AfterEvent",
          "offset_seconds": 0.3,
          "audio_duration": 5.08
        }
      },
      {
        "id": "step_03",
        "order_index": 3,
        "title": "\u0D85\u0D9C\u0DBA \u0D91\u0D9A \u0DC0\u0DB1 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1 \u0DAD\u0DDD\u0DBB\u0DCF\u0D9C\u0DD0\u0DB1\u0DD3\u0DB8",
        "type": "select_bits",
        "duration": 6.6,
        "visual": {
          "binary": "10110110",
          "place_values": [
            128,
            64,
            32,
            16,
            8,
            4,
            2,
            1
          ],
          "active_indices": [
            0,
            2,
            3,
            5,
            6
          ],
          "highlight_color": "#7EE787",
          "custom_props": {}
        },
        "narration": {
          "text": "\u0DB8\u0DD9\u0DC4\u0DD2 \u0D85\u0D9C\u0DBA \u0D91\u0D9A \u0DC0\u0DB1 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DC0\u0DBD\u0DA7 \u0D85\u0DAF\u0DCF\u0DC5 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DD3\u0DBA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DB4\u0DB8\u0DAB\u0D9A\u0DCA \u0D85\u0DB4\u0DD2 \u0D91\u0D9A\u0DAD\u0DD4 \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8\u0DA7 \u0DAD\u0DDD\u0DBB\u0DCF\u0D9C\u0DB1\u0DCA\u0DB1\u0DC0\u0DCF.",
          "spoken_text": "\u0DB8\u0DD9\u0DC4\u0DD2 \u0D85\u0D9C\u0DBA \u0D91\u0D9A \u0DC0\u0DB1 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DC0\u0DBD\u0DA7 \u0D85\u0DAF\u0DCF\u0DC5 \u0DC3\u0DCA\u0DAE\u0DCF\u0DB1\u0DD3\u0DBA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DB4\u0DB8\u0DAB\u0D9A\u0DCA \u0D85\u0DB4\u0DD2 \u0D91\u0D9A\u0DAD\u0DD4 \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8 \u0DC3\u0DB3\u0DC4\u0DCF \u0DC0\u0DD9\u0DB1\u0DCA \u0D9A\u0DBB\u0D9C\u0DB1\u0DCA\u0DB1\u0DC0\u0DCF.",
          "anchor": "step_03_active_highlight",
          "timing": "AfterEvent",
          "offset_seconds": 0.3,
          "audio_duration": 6
        }
      },
      {
        "id": "step_04",
        "order_index": 4,
        "title": "\u0D91\u0D9A\u0DAD\u0DD4 \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8\u0DDA \u0DB4\u0DCA\u200D\u0DBB\u0D9A\u0DCF\u0DC1\u0DB1\u0DBA",
        "type": "addition_expression",
        "duration": 7.52,
        "visual": {
          "binary": "10110110",
          "expression": "128 \u002B 32 \u002B 16 \u002B 4 \u002B 2",
          "highlight_color": "#FFD700",
          "custom_props": {}
        },
        "narration": {
          "text": "\u0DAF\u0DD0\u0DB1\u0DCA \u0DAD\u0DDD\u0DBB\u0DCF\u0D9C\u0DAD\u0DCA \u0D85\u0D9C\u0DBA\u0DB1\u0DCA \u0DC0\u0DB1 128 \u002B 32 \u002B 16 \u002B 4 \u002B 2 \u0D91\u0D9A\u0DAD\u0DD4 \u0D9A\u0DBB\u0DB8\u0DD4.",
          "spoken_text": "\u0D91\u0D9A\u0DC3\u0DD2\u0DBA \u0DC0\u0DD2\u0DC3\u0DD2 \u0D85\u0DA7, \u0DAD\u0DD2\u0DC3\u0DCA \u0DAF\u0DD9\u0D9A, \u0DAF\u0DC4\u0DC3\u0DBA, \u0DC4\u0DAD\u0DBB \u0DC3\u0DC4 \u0DAF\u0DD9\u0D9A \u0D91\u0D9A\u0DAD\u0DD4 \u0D9A\u0DC5 \u0DC0\u0DD2\u0DA7 \u0D85\u0DC0\u0DC3\u0DCF\u0DB1 \u0DB4\u0DD2\u0DC5\u0DD2\u0DAD\u0DD4\u0DBB \u0D91\u0D9A\u0DC3\u0DD2\u0DBA \u0D85\u0DC3\u0DD6 \u0DAF\u0DD9\u0D9A \u0DBD\u0DD9\u0DC3 \u0DBD\u0DD0\u0DB6\u0DD9\u0DB1\u0DC0\u0DCF.",
          "anchor": "step_04_expr_shown",
          "timing": "AfterEvent",
          "offset_seconds": 0.3,
          "audio_duration": 6.92
        }
      },
      {
        "id": "step_05",
        "order_index": 5,
        "title": "\u0D85\u0DC0\u0DC3\u0DCF\u0DB1 \u0DB4\u0DD2\u0DC5\u0DD2\u0DAD\u0DD4\u0DBB",
